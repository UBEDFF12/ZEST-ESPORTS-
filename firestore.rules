rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ajubaid.ik@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Global Safety Net Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Users Collection: profiles and dual wallet balances
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) || isAdmin();
      // Gamers cannot modify their own financial balances or ban status directly
      allow update: if (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['depositBalance', 'winningsBalance', 'isBanned'])
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Tournaments Collection
    match /tournaments/{tournamentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();

      // Subcollection: Slots
      match /slots/{slotId} {
        allow read: if isSignedIn();
        // Allow slot booking with concurrency validation
        allow create, update: if isSignedIn() && (
          (request.resource.data.userId == request.auth.uid) || isAdmin()
        );
        allow delete: if isAdmin();
      }
    }

    // 3. Transactions Immutable Ledger
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      // Transactions logged by users or admin
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // 4. Preloaded Google Play Redeem Codes Inventory
    match /redeem_codes/{codeId} {
      allow read, write: if isAdmin();
    }
  }
}
